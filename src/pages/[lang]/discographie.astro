---
import Base from '../../layouts/Base.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import { LANGS, SITE, type Lang } from '../../data/site';
import { t } from '../../i18n/ui';
import { releases, releasesByYear } from '../../data/releases';
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const d = t(lang);
const ld = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: d.disco.title,
  itemListElement: releases.map((r, i) => ({
    '@type': 'ListItem', position: i + 1,
    item: { '@type': r.type === 'album' ? 'MusicAlbum' : 'MusicRecording', name: r.title, byArtist: { '@id': `${SITE.url}/#artist` }, ...(r.date ? { datePublished: r.date } : { copyrightYear: r.year }), ...(r.cover ? { image: `${SITE.url}${r.cover}` } : {}), ...(r.apple || r.youtube ? { url: r.apple || r.youtube } : {}) },
  })),
}];
---
<Base lang={lang} page="discographie" jsonLd={ld} image="/img/covers/carnaval-hallucine.webp">
  <div class="wrap page-head"><h1>{d.disco.title}</h1><p>{d.disco.sub}</p><p class="mono">{d.disco.count(releases.length)}</p></div>
  <div class="wrap">
    {releasesByYear().map(([year, list]) => (
      <section class="year-block" id={`y${year}`}>
        <div class="year">{year}<small>{d.disco.count(list.length)}</small></div>
        <div class="grid grid-3">{list.map((r) => <ReleaseCard r={r} lang={lang} />)}</div>
      </section>
    ))}
  </div>
  <div style="height:3rem"></div>
</Base>
